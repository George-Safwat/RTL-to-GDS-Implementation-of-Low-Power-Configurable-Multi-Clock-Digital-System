RuleName: Ac_conv02 
off  Assertion   PROVED              Top/SYS_TOP.v  104  "SYS_TOP"  [SYS_TOP.UART_TX_V_SYNC]
on   Assertion   Partially-Proved    Top/SYS_TOP.v  103  "SYS_TOP"  [SYS_TOP.FIFO_FULL]

RuleName: Ac_cdc01a 
on   Assertion   Partially-Proved    ASYNC_FIFO/DF_Sync.v  32  "SYS_TOP.U0_UART_FIFO.u_w2r_sync"  [SFlop:SYS_TOP.U0_UART_FIFO.gray_w_ptr[3] SClk:SYS_TOP.REF_CLK DFlop:SYS_TOP.U0_UART_FIFO.u_w2r_sync.meta_flop[3] DClk:SYS_TOP.UART_TX_CLK]

RuleName: Ac_datahold01a 
off  Assertion   PROVED              DATA_SYNC/DATA_SYNC.v  76  "SYS_TOP.U0_ref_sync"  [Des: "SYS_TOP.U0_ref_sync.\sync_bus_reg[0] .Q", Src: "SYS_TOP.U0_UART.U0_UART_RX.u_deserializer.\p_data_reg[0] .Q"]
on   Assertion   Partially-Proved    UART/UART_TX/uart_top.v  16  "SYS_TOP.U0_UART.U0_UART_TX"  [Des: "SYS_TOP.U0_UART.U0_UART_TX.\data_reg_reg[0] .Q", Src: "SYS_TOP.U0_UART_FIFO.u_fifo_mem.\FIFO_MEM_reg[0][0] .Q"]
