current_design SYS_TOP

####################################################################################
           #########################################################
                  #### Section 1 : Clock Definition ####
           #########################################################
#################################################################################### 

#REF_CLK period = 20 ns (50 MHz) with clock domain d0
clock -name REF_CLK -period 20 -waveform {0 10} -domain d0

#UART_CLK period = 271.267 ns (3.6864 MHz) with clock domain d1
clock -name UART_CLK -period 271.267 -waveform {0 135.633} -domain d1

#Internal clocks (declared so SpyGlass does not report them as unconstrained)
#UART_TX_CLK = UART_CLK / 32 (DIV_RATIO = 32 from REG3), same domain as UART_CLK
clock -name UART_TX_CLK -period 8680.555 -waveform {0 4340.278} -domain d1

#UART_RX_CLK = UART_CLK / 1 (prescale 32), same domain as UART_CLK
clock -name UART_RX_CLK -period 271.267 -waveform {0 135.633} -domain d1

#ALU_CLK = REF_CLK gated by CLK_GATE, same domain as REF_CLK
clock -name ALU_CLK -period 20 -waveform {0 10} -domain d0

####################################################################################
           #########################################################
                  #### Section 2 : Reset Definition ####
           #########################################################
####################################################################################

#Active Low Async Reset (RST_N)
reset -name RST_N -value 0 -async

####################################################################################
           #########################################################
             #### Section 3 : set input/output clock domains  ####
           #########################################################
####################################################################################

#Constrain Port UART_RX_IN (serial input, received in the UART_CLK domain)
abstract_port -ports UART_RX_IN    -clock UART_CLK

#Constrain Port UART_TX_O (serial output, driven from the UART_CLK domain)
abstract_port -ports UART_TX_O     -clock UART_CLK

#Constrain Port parity_error
abstract_port -ports parity_error  -clock UART_CLK

#Constrain Port framing_error
abstract_port -ports framing_error -clock UART_CLK

abstract_port -ports RST_N -clock REF_CLK

####################################################################################
           #########################################################
             #### Section 4 : DATA/RESET Synchronizers  ####
           #########################################################
####################################################################################
quasi_static -name SYS_TOP.U0_RegFile.REG2
quasi_static -name SYS_TOP.U0_RegFile.REG3



